# Optional for public preview: all API and generation routes remain disabled
# until both private studio credentials are configured.
STUDIO_USERNAME=
STUDIO_PASSWORD=

# Required to enable website captures
FIRECRAWL_API_KEY=

# Sandbox execution on Vercel; OIDC is supplied by Vercel deployments
SANDBOX_PROVIDER=vercel

# Vercel AI Gateway can use Vercel OIDC on supported routes.
# Some legacy provider-specific routes still require migration.
# Optional fallback when OIDC is unavailable:
# AI_GATEWAY_API_KEY=

# Optional local sandbox authentication:
# VERCEL_OIDC_TOKEN=
# Or VERCEL_TEAM_ID, VERCEL_PROJECT_ID, VERCEL_TOKEN

# Optional alternative sandbox:
# SANDBOX_PROVIDER=e2b
# E2B_API_KEY=

# Optional provider-specific AI keys / faster edits:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MORPH_API_KEY=
